config_version=5

[application]
config/name="Home Twenty"
config/description="Work a snow route with Deb on the radio in a Wisconsin blizzard, winter 1998."
run/main_scene="res://game/shift.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://game/icon.svg"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.075, 0.093, 0.12, 1)

